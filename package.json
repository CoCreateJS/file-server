{
  "name": "@cocreate/file-server",
  "version": "1.26.0",
  "description": "A simple file-server component in vanilla javascript. Easily configured using HTML5 data-attributes and/or JavaScript API.",
  "keywords": [
    "file-server",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "A simple file-server component in vanilla javascript. Easily configured using HTML5 data-attributes and/or JavaScript API.",
      "source": "src/index.js",
      "api": {
        "exports": [
          "init"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-file-server.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-file-server/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/file-server",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/utils": "^1.57.0",
    "@cocreate/config": "^1.21.0",
    "@cocreate/server-side-render": "^1.20.0",
    "@cocreate/server-sitemap": "^1.12.0"
  }
}
